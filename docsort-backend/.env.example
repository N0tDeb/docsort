# ── DocSort backend environment ────────────────────────────────
# Copy this file to ".env" and fill in real values. Never commit ".env".

# Runtime mode. Local development may use an HTTP Supabase emulator;
# production mode refuses to start unless SUPABASE_URL uses HTTPS.
APP_ENVIRONMENT=development

# Supabase — REQUIRED (project REST URL + service-role key)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# JWT — REQUIRED. Generate a strong, unique value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The server will refuse to start if this is empty or left as a placeholder value.
JWT_SECRET=

# Google Gemini — recommended for AI extraction/classification. If omitted,
# Tesseract OCR still runs but AI extraction falls back to Needs Review.
# Keep the real key server-side only; never place it in Flutter/Dart.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# CORS — comma-separated browser origins allowed to call the API (Flutter web).
# Native mobile clients are unaffected. Example for local dev:
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# OCR (Tesseract). On Windows, point to the full .exe path.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Optional application settings (defaults shown)
# ACCESS_TOKEN_EXPIRE_MINUTES=1440
# MAX_UPLOAD_BYTES=20971520
# MAX_PDF_PAGES=25
# MAX_IMAGE_PIXELS=40000000
# MAX_AI_PAGES=8
# MAX_AI_OCR_CHARS=20000
# MAX_CONCURRENT_UPLOAD_PROCESSING_JOBS=2
# MAX_WEBSOCKET_CONNECTIONS_PER_USER=3
# MAX_FOLDER_PAGE_SIZE=100
# MAX_PERSONAL_FOLDER_SCAN=500
# MAX_FOLDER_EXPORT_DOCUMENTS=250
# MAX_FOLDER_EXPORT_BYTES=104857600
# EXPORT_SPOOL_MEMORY_BYTES=8388608
# AUTOSORT_CONFIDENCE_THRESHOLD=0.75
# OCR_LANGUAGES=mar+hin+eng
